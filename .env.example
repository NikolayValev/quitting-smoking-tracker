# Database (Neon Postgres - never expires, get free DB at neon.tech)
DATABASE_URL=postgresql://user:password@host/database

# Clerk Authentication (get keys at clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Clerk webhook signing secret (Clerk dashboard > Webhooks > your endpoint).
# Required by POST /api/webhooks/clerk, which erases a user's local rows when
# Clerk reports user.deleted. Without it that endpoint rejects every delivery.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app

# PostHog (server-side error tracking + analytics; leave unset to fall back to console)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
